; Proyek Godot 4 - klien Android "Game Petualang".
; Disunting terutama lewat editor Godot; hati-hati bila mengubah manual.

config_version=5

[application]

config/name="Game Petualang"
config/version="0.75.0"
config/description="Klien RPG 2D untuk server Game_server"
run/main_scene="res://scenes/login.tscn"
run/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon/icon_512.png"

[autoload]

Patcher="*res://scripts/patcher.gd"
Api="*res://scripts/api.gd"
Session="*res://scripts/session.gd"
Sound="*res://scripts/sound.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=640
window/size/window_height_override=360
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
